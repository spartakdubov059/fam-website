-- Anonymous, allowlisted event counters only; no request text, IPs, or identity.
CREATE TABLE fam_site_error_counts (
  hour_bucket Timestamp NOT NULL,
  event_code Utf8 NOT NULL,
  page_area Utf8 NOT NULL,
  event_count Uint32 NOT NULL,
  created_at Timestamp NOT NULL,
  updated_at Timestamp NOT NULL,
  PRIMARY KEY (hour_bucket, event_code, page_area)
) WITH (TTL = Interval("P30D") ON created_at);
