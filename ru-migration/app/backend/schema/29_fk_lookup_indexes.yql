-- Keep the same-school account cleanup lookups bounded as these tables grow.
-- Synchronous indexes are maintained atomically with writes by YDB.
ALTER TABLE fam_avatar_reviews ADD INDEX fam_avatar_reviews_user_id_idx GLOBAL ON (user_id);
ALTER TABLE fam_school_announcements ADD INDEX fam_school_announcements_author_id_idx GLOBAL ON (author_id);
ALTER TABLE fam_school_polls ADD INDEX fam_school_polls_author_id_idx GLOBAL ON (author_id);
ALTER TABLE fam_school_poll_votes ADD INDEX fam_school_poll_votes_voter_id_idx GLOBAL ON (voter_id);
