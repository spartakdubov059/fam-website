-- Apply only to a new, isolated YDB database after infrastructure review.
-- This table is not a complete FAM schema; no production data is imported.
CREATE TABLE fam_listings (
  id Utf8 NOT NULL,
  user_id Utf8 NOT NULL,
  school_id Utf8 NOT NULL,
  title Utf8 NOT NULL,
  description Utf8 NOT NULL,
  category Utf8 NOT NULL,
  price_text Utf8 NOT NULL,
  is_event Bool NOT NULL,
  event_date Utf8 NOT NULL,
  event_time Utf8 NOT NULL,
  event_type Utf8 NOT NULL,
  max_seats Uint32 NOT NULL,
  status Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  PRIMARY KEY (id)
);
