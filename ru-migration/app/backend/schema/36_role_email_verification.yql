-- Stores only keyed digests and lifecycle counters; email addresses and codes are never persisted.
CREATE TABLE fam_role_email_verifications (
  issuer Utf8 NOT NULL,
  subject Utf8 NOT NULL,
  user_id Utf8 NOT NULL,
  email_digest Utf8 NOT NULL,
  code_digest Utf8 NOT NULL,
  issued_seconds Uint64 NOT NULL,
  expires_seconds Uint64 NOT NULL,
  attempt_count Uint32 NOT NULL,
  window_started_seconds Uint64 NOT NULL,
  send_count Uint32 NOT NULL,
  sent_seconds Uint64 NOT NULL,
  verified_seconds Uint64 NOT NULL,
  PRIMARY KEY (issuer, subject)
);
