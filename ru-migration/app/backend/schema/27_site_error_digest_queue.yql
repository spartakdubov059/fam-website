-- Durable queue for the source site's 15-minute aggregate error digest.
-- Only allowlisted counters and a fixed summary are persisted; no request content or identity.
CREATE TABLE fam_site_error_digest_tasks (
  digest_slot Utf8 NOT NULL,
  status Utf8 NOT NULL,
  attempt_count Uint32 NOT NULL,
  max_attempts Uint32 NOT NULL,
  available_at Timestamp NOT NULL,
  claimed_by Utf8?,
  claim_token Utf8?,
  lease_expires_at Timestamp?,
  generated_at Timestamp?,
  metrics_json Utf8?,
  summary Utf8?,
  last_error_code Utf8?,
  created_at Timestamp NOT NULL,
  updated_at Timestamp NOT NULL,
  PRIMARY KEY (digest_slot)
) WITH (TTL = Interval("P60D") ON created_at);
