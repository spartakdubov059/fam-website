# Example only: store real values in the Cloud Function version's secret environment,
# never in GitHub, this file, the API Gateway specification, or a browser bundle.
# Configure either the Yandex ID web flow OR the OIDC bearer flow, not both.

# Required for the Russian YDB database. Use the database endpoint and database path.
FAM_RU_DATABASE_URL=grpcs://REPLACE_WITH_YDB_ENDPOINT/ru-central1/REPLACE_WITH_FOLDER_ID/REPLACE_WITH_DATABASE_ID

# Recommended web authentication: Yandex ID OAuth callback must be
# https://YOUR_GATEWAY_DOMAIN/auth/yandex/callback and registered with Yandex ID.
FAM_RU_YANDEX_CLIENT_ID=REPLACE_WITH_YANDEX_OAUTH_CLIENT_ID
FAM_RU_YANDEX_REDIRECT_URI=https://REPLACE_WITH_GATEWAY_DOMAIN/auth/yandex/callback
FAM_RU_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Optional role-request email verification. Requires a Yandex Cloud Postbox
# sender identity and a function service account allowed to send through Postbox.
# The sender remains disabled unless this address is configured.
# FAM_RU_POSTBOX_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER_ADDRESS

# Optional but recommended: keep independent from the session signing secret.
FAM_RU_SAFETY_HMAC_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# Alternative auth mode only. If used, remove the three Yandex ID settings above.
# FAM_RU_AUTH_ISSUER=https://REPLACE_WITH_OIDC_ISSUER
# FAM_RU_AUTH_AUDIENCE=REPLACE_WITH_OIDC_AUDIENCE
# FAM_RU_AUTH_JWKS_URL=https://REPLACE_WITH_OIDC_JWKS_URL

# Optional YDB metadata endpoint override. Normally omit inside Yandex Cloud Functions.
# FAM_RU_YDB_METADATA_URL=http://REPLACE_WITH_METADATA_ENDPOINT

# Required for photo upload/review features; use a dedicated private bucket.
# FAM_RU_S3_ENDPOINT=https://REPLACE_WITH_OBJECT_STORAGE_ENDPOINT
# FAM_RU_S3_BUCKET=REPLACE_WITH_DEDICATED_PRIVATE_BUCKET
# FAM_RU_S3_REGION=ru-central1
# FAM_RU_S3_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_ACCESS_KEY_ID
# FAM_RU_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_SECRET_KEY

# Optional internal coder bridge only; leave unset unless a separately audited
# trusted worker exists. This does not start a model or grant code execution.
# FAM_RU_CODER_WORKER_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_BYTES
