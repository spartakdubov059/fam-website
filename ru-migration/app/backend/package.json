{
  "name": "fam-ru-isolated-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "start": "node server.mjs",
    "check:timers": "node check-systemd-timer-health.mjs",
    "enqueue:safe-coder-task": "node enqueue-safe-coder-task.mjs",
    "agent:enqueue": "node enqueue-safe-agent-task.mjs",
    "agent:process": "node process-safe-agent-tasks.mjs",
    "agent:run": "node run-safe-agent-worker.mjs",
    "bootstrap:initial-school-admin": "node bootstrap-initial-school-admin.mjs",
    "test": "node --test test/*.test.mjs",
    "check:system": "node check-ru-system-health.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@ydbjs/auth": "6.3.1",
    "@ydbjs/core": "6.3.1",
    "@ydbjs/query": "6.3.0",
    "sharp": "0.35.5"
  }
}
